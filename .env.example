# Template for the plugin's .env file. Copy to `.env` in this folder (the plugin
# directory, next to data.json) and fill in your own values.
#
# Format: one KEY=VALUE per line. Blank lines and lines starting with # are
# ignored. Matching quotes around a value are stripped, and everything after the
# first = is kept, so connection strings with ?query=params work unquoted.
# An empty value means "not set here" — the settings UI wins for that key.
# Unknown keys are ignored with a warning in the developer console.

# MongoDB connection string. Required for a sync to run.
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=Cluster0

# Database holding the `notes` collection.
DB_NAME=activity-telemetry

# Only sync notes under this vault path. Leave empty to sync the whole vault.
SUBDIR=02 Knowledge

# Keep wikilink edges to notes that don't exist yet, and create a placeholder
# node for each. Booleans accept true, on, or 1; anything else is false.
INCLUDE_UNRESOLVED=on

# Log date fallbacks and per-file details to the developer console.
# VERBOSE=on
